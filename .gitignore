# ==========================================
# AURORA — Git Ignore Configuration
# ==========================================

# Environment variables & API credentials
.env
.env.local
.env.*.local
!.env.example

# Local SQLite databases & Vector/Graph storage
*.db
*.sqlite
*.sqlite3
pg_data/
neo4j_data/
qdrant_data/
redis_data/
qdrant_storage/

# Python cache & virtual environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.venv/
venv/
ENV/
env/

# Node.js dependencies & Vite build artifacts
node_modules/
frontend/node_modules/
dist/
frontend/dist/
.npm
.eslintcache

# Logs & debugging
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Uploads & Generated Exports (Keep directory structure with .gitkeep)
backend/uploads/*
!backend/uploads/.gitkeep
backend/exports/*
!backend/exports/.gitkeep

# IDEs & System files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
