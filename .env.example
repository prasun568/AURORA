# ==========================================
# AURORA Environment Configuration Template
# Copy this file to .env and configure keys
# ==========================================

# LLM Providers
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Academic & Web Search APIs
TAVILY_API_KEY=your_tavily_api_key_here

# Primary Database (PostgreSQL)
DATABASE_URL=postgresql://aurora:aurora123@localhost:5432/aurora

# In-Memory Cache (Redis)
REDIS_URL=redis://localhost:6379

# Graph Database (Neo4j)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123

# Vector Memory (Qdrant)
QDRANT_URL=http://localhost:6333

# JWT Security & Authentication
SECRET_KEY=generate_a_secure_random_32_character_jwt_secret_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
